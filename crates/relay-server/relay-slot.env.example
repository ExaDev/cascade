# Per-slot settings for the side-by-side update path. Copy this to
# /etc/cascade/relay-blue.env and /etc/cascade/relay-green.env and give each a
# different metrics address, so both slots can run during an update and the
# update script can probe each slot's own /health. An announce endpoint
# (CASCADE_RELAY_ANNOUNCE), if used, needs a distinct address per slot too.
#
# The shared secret stays in /etc/cascade/relay.env; keep it out of these files.

# relay-blue.env
CASCADE_RELAY_METRICS=127.0.0.1:9998

# relay-green.env uses this line instead:
# CASCADE_RELAY_METRICS=127.0.0.1:9996
